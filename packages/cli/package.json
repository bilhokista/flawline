{
  "name": "flawline",
  "version": "0.9.0",
  "description": "Canvas, UVP and go-to-market as claims in git. A checker fails the build when a guess is dressed up as a fact.",
  "keywords": [
    "founder",
    "startup",
    "strategy",
    "product-discovery",
    "jobs-to-be-done",
    "lean-canvas",
    "go-to-market",
    "claude-code",
    "agent-skills",
    "validation",
    "vibe-coding",
    "uvp",
    "positioning"
  ],
  "license": "MIT",
  "author": "Dian Bilhokista",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilhokista/flawline.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bilhokista/flawline#readme",
  "bugs": {
    "url": "https://github.com/bilhokista/flawline/issues"
  },
  "type": "module",
  "bin": {
    "flawline": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && node -e \"['README.md','CHANGELOG.md'].forEach(f=>require('fs').copyFileSync('../../'+f,f))\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.1.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
